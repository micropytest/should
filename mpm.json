{
  "v": "2026.6.0",
  "name": "should",
  "desc": "An assertion lib for micro:Pytest and MicroPython.",
  "keywords": [
    "assertion",
    "testing"
  ],
  "urls": {
    "homepage": "https://micropytest.com",
    "issues": "https://github.com/micropytest/should/issues"
  },
  "src": {
    "dir": "should",
    "include": [
      "__init__.py",
      "_assert.py",
      "_manifest.py",
      "_should.py",
      "_throw.py",
      "_util.py",
      "_wrapper.py"
    ]
  },
  "deps": {
    "dir": "deps/lib",
    "prod": [
      "lib://abc",
      "lib://inspect",
      "mpmi://typing"
    ],
    "dev": [
      "lib://unittest",
      "lib://unittest-discover"
    ]
  }
}
