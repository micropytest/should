{
  "v": "2026.6.5",
  "name": "should",
  "desc": "An assertion lib for micro:Pytest and MicroPython.",
  "keywords": [
    "assertion",
    "testing"
  ],
  "urls": {
    "homepage": "https://micropytest.com",
    "git": "https://github.com/micropytest/should",
    "issues": "https://github.com/micropytest/should/issues"
  },
  "src": {
    "dir": "should",
    "include": [
      "__init__.py",
      "_assert.py",
      "_manifest.py",
      "_should.py",
      "_throw.py",
      "_util.py",
      "_wrapper.py"
    ]
  },
  "deps": {
    "lib": "deps/lib",
    "prod": [
      "lib://abc",
      "lib://inspect",
      "mpmi://typing"
    ],
    "dev": [
      "lib://unittest",
      "lib://unittest-discover"
    ]
  },
  "jobs": {
    "build": {
      "desc": "Prepares the package for its publish.",
      "env": true,
      "out": "cmdln+out",
      "params": {
        "segment": {
          "desc": "Version segment to increment: major, minor or patch.",
          "type": "str",
          "value": ""
        }
      },
      "run": [
        "[ -n \"{segment}\" ] && micropython -m mpm inc-v {segment} || exit 0",
        "micropython -m mpm _manifest",
        "micropython -m mpm sync"
      ]
    },
    "tests": {
      "desc": "Runs the tests.",
      "env": true,
      "out": "cmdln+out",
      "run": [
        "clear",
        "scripts/tests"
      ]
    }
  }
}
